# Puerto del servidor Express
PORT=3000

# URL base que usa el frontend para llamar al backend
VITE_API_URL=http://localhost:3000

# Polling de recarga en caliente: true por defecto (necesario en Docker Desktop
# macOS/Windows). Poner false para menor uso de CPU en Linux nativo.
CHOKIDAR_USEPOLLING=true


# Solo para pnpm db:setup, nunca para el backend en runtime
DB_SETUP_HOST=localhost
DB_SETUP_PORT=5432
DB_SETUP_USER=postgres
DB_SETUP_PASSWORD=postgres
DB_SETUP_DATABASE=postgres

# Conexión de solo lectura que usa el backend (pool.ts)
PGARMOR_DB_HOST=localhost
PGARMOR_DB_PORT=5432
PGARMOR_DB_NAME=postgres
PGARMOR_AUDITOR_PASSWORD=cambia-esto-en-tu-local

# Usuario de auditoría que sí usa el backend
PGARMOR_AUDIT_PASSWORD=cambia-esto-en-tu-local